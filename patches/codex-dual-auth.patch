+const CODEX_CONNECTORS_HOME_ENV_VAR: &str = "CODEX_CONNECTORS_HOME";
+
+async fn codex_apps_auth_context_from_env(
+    config: &Config,
+) -> std::io::Result<Option<CodexAppsAuthContext>> {
+    let Some(raw_home) = std::env::var_os(CODEX_CONNECTORS_HOME_ENV_VAR) else {
+        return Ok(None);
+    };
+    let codex_home = Path::new(&raw_home);
+    if !codex_home.is_absolute() {
+        return Err(std::io::Error::new(
+            ErrorKind::InvalidInput,
+            format!("{CODEX_CONNECTORS_HOME_ENV_VAR} must be an absolute path"),
+        ));
+    }
+    if codex_home == config.codex_home.as_path() {
+        return Err(std::io::Error::new(
+            ErrorKind::InvalidInput,
+            format!("{CODEX_CONNECTORS_HOME_ENV_VAR} must differ from CODEX_HOME"),
+        ));
+    }
+
+    let mut auth_config = config.auth_config();
+    auth_config.codex_home = codex_home.to_path_buf();
+    let auth_manager =
+        AuthManager::shared_from_auth_config(auth_config, /*enable_codex_api_key_env*/ false)
+            .await
+            .map_err(std::io::Error::other)?;
+    let auth = auth_manager.auth().await;
+    if !auth.as_ref().is_some_and(CodexAuth::uses_codex_backend) {
+        return Err(std::io::Error::new(
+            ErrorKind::PermissionDenied,
+            format!(
+                "{CODEX_CONNECTORS_HOME_ENV_VAR} does not contain a ChatGPT login; run the launch helper's connector-account sign-in first"
+            ),
+        ));
+    }
+
+    info!(
+        connectors_home = %codex_home.display(),
+        "Codex Apps will use an isolated ChatGPT identity"
+    );
+    Ok(Some(CodexAppsAuthContext {
+        codex_home: codex_home.to_path_buf(),
+        auth_manager,
+    }))
+}

